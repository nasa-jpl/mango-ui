{
  "name": "mango-ui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=18.12.0",
    "npm": ">=8.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:force": "vite build",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:css": "stylelint 'src/**/*.css'",
    "lint:css:fix": "stylelint 'src/**/*.css' --fix",
    "preview": "vite preview --port 5174 --host",
    "test": "TZ=UTC vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:codegen": "playwright codegen https://localhost:5173",
    "test:e2e:debug": "PWDEBUG=1 playwright test --workers=1 --project=chromium",
    "test:unit": "TZ=UTC vitest run",
    "test:mutation": "TZ=UTC stryker run"
  },
  "dependencies": {
    "d3-format": "^3.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite-plugin-cesium": "1.2.23",
    "vite-plugin-static-copy": "^3.1.1"
  },
  "devDependencies": {
    "@ag-grid-community/core": "^32.1.0",
    "@nasa-jpl/stellar-react": "2.0.0-alpha.71",
    "@playwright/test": "^1.53.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/vitest-runner": "^8.7.1",
    "@tanstack/react-table": "^8.9.8",
    "@tanstack/react-virtual": "^3.0.0-alpha.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-format": "^3.0.4",
    "@types/d3-scale": "^4.0.8",
    "@types/leaflet": "^1.9.8",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.10.4",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.17",
    "@types/react-grid-layout": "^1.3.5",
    "@types/stats.js": "^0.17.3",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.6.1",
    "ag-grid-react": "^32.2.2",
    "autoprefixer": "^10.4.21",
    "chart.js": "^4.4.1",
    "chartjs-adapter-luxon": "^1.3.1",
    "chartjs-plugin-zoom": "^2.0.1",
    "classnames": "^2.3.2",
    "d3-scale": "^4.0.2",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^24.1.3",
    "leaflet": "^1.9.4",
    "lodash-es": "^4.17.21",
    "postcss": "^8.5.3",
    "react-grid-layout": "^1.4.4",
    "react-router-dom": "^6.21.0",
    "stats.js": "^0.17.0",
    "stylelint": "^16.2.1",
    "stylelint-config-standard": "^36.0.0",
    "stylelint-order": "^6.0.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.3.3",
    "unique-names-generator": "^4.7.1",
    "uuid": "^11.1.0",
    "vite": "^5.0.9",
